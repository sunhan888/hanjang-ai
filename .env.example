# 복사해서 backend/.env 로 쓴다:  cp .env.example backend/.env   (키는 절대 커밋하지 않는다)

# 판독기: mock(키 없이 예시 결과) | mock-noisy(평가 연습) | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# 이미지 입력과 json_schema 출력을 지원하는 모델 이름
# 이미지 입력과 json_schema 출력을 지원하는 모델 이름
OPENAI_MODEL=gpt-4.1

# 비우면 메모리 저장소 (서버를 다시 켜면 결과가 사라짐). 서비스 키는 서버에만 둔다
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESULT_TTL_HOURS=24
MAX_UPLOAD_MB=10

# 할 일 문장을 LLM 으로 한 번 더 다듬기 (숫자 대조 가드 있음, 호출 1회 추가)
AGENT_LLM_POLISH=0
# 시연용 '오늘' 고정 (예: 2026-10-20). 실제 운영에서는 비운다
TODAY=
# 화면을 다른 도메인에서 띄울 때만 (쉼표로 여러 개)
CORS_ORIGINS=*
# mock 판독기의 지연(초): 판독 중 화면을 보기 위한 것
MOCK_DELAY_SEC=0.8
